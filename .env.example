DATABASE_URL=postgresql://postgres:postgres@localhost:5432/kiotviet_lite
PORT=3000

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=false
BCRYPT_ROUNDS=12
ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=info
LOG_DIR=./logs

# Kho tệp nhập Excel: phải là đường dẫn tuyệt đối, thư mục được tạo khi chạy môi trường dev.
BULK_IMPORT_DIR=/tmp/kiotviet-lite-imports

# Notification config encryption key (32 bytes hex, 64 chars)
# Empty = notifications disabled, app still runs
NOTIFICATION_CONFIG_KEY=

# Chỉ môi trường dev: sau khi migrate và chạy `pnpm --filter @kiotviet-lite/api db:seed`,
# màn đăng nhập Vite hiển thị 3 tài khoản mẫu và tự điền mật khẩu khi chọn.
# Không chạy seed trên database có dữ liệu cần giữ: lệnh seed xóa dữ liệu cũ.
