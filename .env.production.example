# Mẫu env production. Trên server: cp .env.production.example .env rồi sửa giá trị thật.
# File .env thật KHÔNG commit.

# ===== Postgres (compose dùng khởi tạo DB, service backup cũng đọc) =====
POSTGRES_USER=kiotviet
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=kiotviet_lite

# ===== API =====
# Lưu ý: user/password phải khớp các biến POSTGRES_* ở trên, host là tên service "postgres"
DATABASE_URL=postgresql://kiotviet:change-me-strong-password@postgres:5432/kiotviet_lite
PORT=3000
# Số proxy tin cậy đứng trước API (nginx = 1); 0 thì bỏ qua X-Forwarded-For và dùng IP socket.
TRUSTED_PROXY_HOPS=1

# Sinh bằng: openssl rand -base64 48 (mỗi secret một lần, hai giá trị phải khác nhau).
# API production từ chối khởi động nếu còn giữ giá trị mẫu dưới đây hoặc secret yếu.
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=true
BCRYPT_ROUNDS=12

# Domain thật phía sau Cloudflare Tunnel
ALLOWED_ORIGINS=https://your-domain.example.com

LOG_LEVEL=info
LOG_DIR=/app/logs

# BẮT BUỘC: khoá AES-256-GCM mã hoá token/secret của kênh thông báo (32 bytes hex, 64 ký tự).
# Sinh bằng: openssl rand -hex 32. API production từ chối khởi động nếu thiếu hoặc sai định dạng.
# Giữ cố định: đổi khoá thì các kênh đã lưu không giải mã được, phải nhập lại bí mật.
NOTIFICATION_CONFIG_KEY=

# ===== Nginx =====
# Port bind trên 127.0.0.1 của host. cloudflared trỏ vào http://localhost:8080
WEB_PORT=8080

# ===== Cảnh báo vận hành (API, backup, deploy/scripts/monitor.sh) =====
# Rỗng hết = tắt (chỉ ghi log). Telegram: tạo bot qua @BotFather, chat_id của nhóm vận hành.
OPS_ALERT_ENABLED=true
OPS_ALERT_SOURCE=kiotviet-lite
OPS_ALERT_TELEGRAM_BOT_TOKEN=
OPS_ALERT_TELEGRAM_CHAT_ID=
# Webhook (chỉ https), ký HMAC bằng header X-KVL-Signature nếu có secret
OPS_ALERT_WEBHOOK_URL=
OPS_ALERT_WEBHOOK_SECRET=
# Cùng một cảnh báo không gửi lại trong khoảng này (giây)
OPS_ALERT_THROTTLE_SECONDS=900
# Số phản hồi 5xx trong 5 phút thì cảnh báo
OPS_ALERT_5XX_THRESHOLD=20

# ===== Backup (deploy/backup, runbook docs/deploy.md mục 6) =====
# Giờ chạy mỗi ngày theo TZ
TZ=Asia/Ho_Chi_Minh
BACKUP_TIME=02:30
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
# restore = khôi phục thử vào DB tạm và so số dòng từng bảng; list = chỉ kiểm mục lục bản dump
BACKUP_VERIFY=restore
# Khóa CÔNG KHAI age (age1...), nhiều khóa cách nhau bằng dấu phẩy. Khóa bí mật KHÔNG để trên server.
# Rỗng = bản sao lưu không mã hóa, chỉ giữ trên máy, cảnh báo mỗi lần chạy.
BACKUP_AGE_RECIPIENTS=
# Đích ngoài máy dạng <remote>:<đường dẫn>. Rỗng = không đẩy đi (cảnh báo mỗi lần chạy).
BACKUP_RCLONE_REMOTE=
# false = không xóa bản cũ trên remote, để quy tắc vòng đời hoặc khóa đối tượng của bucket lo
BACKUP_REMOTE_PRUNE=true
# Cấu hình remote tên "offsite" cho rclone, ví dụ Cloudflare R2 / S3 tương thích:
# RCLONE_CONFIG_OFFSITE_TYPE=s3
# RCLONE_CONFIG_OFFSITE_PROVIDER=Cloudflare
# RCLONE_CONFIG_OFFSITE_ACCESS_KEY_ID=
# RCLONE_CONFIG_OFFSITE_SECRET_ACCESS_KEY=
# RCLONE_CONFIG_OFFSITE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# RCLONE_CONFIG_OFFSITE_NO_CHECK_BUCKET=true
# BACKUP_RCLONE_REMOTE=offsite:kiotviet-backups/prod

# ===== Giám sát từ host (deploy/scripts/monitor.sh chạy bằng cron) =====
MONITOR_BACKUP_MAX_AGE_HOURS=26
MONITOR_DISK_MAX_PCT=85
MONITOR_IMPORT_STUCK_MINUTES=30
# URL ping dead man's switch (healthchecks.io...), gọi khi mọi kiểm tra đạt
MONITOR_HEARTBEAT_URL=
