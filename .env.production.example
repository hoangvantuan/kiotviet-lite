# Mẫu env production. Trên server: cp .env.production.example .env rồi sửa giá trị thật.
# File .env thật KHÔNG commit.

# ===== Postgres (compose dùng khởi tạo DB, service backup cũng đọc) =====
POSTGRES_USER=kiotviet
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=kiotviet_lite

# ===== API =====
# Lưu ý: user/password phải khớp các biến POSTGRES_* ở trên, host là tên service "postgres"
DATABASE_URL=postgresql://kiotviet:change-me-strong-password@postgres:5432/kiotviet_lite
PORT=3000

JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=604800
COOKIE_SECURE=true
BCRYPT_ROUNDS=12

# Domain thật phía sau Cloudflare Tunnel
ALLOWED_ORIGINS=https://your-domain.example.com

LOG_LEVEL=info
LOG_DIR=/app/logs

# Khoá mã hoá config notification (32 bytes hex, 64 ký tự). Rỗng = tắt notification.
NOTIFICATION_CONFIG_KEY=

# ===== Nginx =====
# Port bind trên 127.0.0.1 của host. cloudflared trỏ vào http://localhost:8080
WEB_PORT=8080

# ===== Backup =====
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=6
